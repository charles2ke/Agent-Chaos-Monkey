{
  "schemaVersion": 1,
  "tests": [
    {
      "id": "gateway-healthy-control",
      "name": "Sample agent completes a real tool call",
      "definition": {
        "schemaVersion": 1,
        "name": "Gateway healthy control",
        "scenario": "Create a support ticket for my broken laptop",
        "connector": "ServiceNow",
        "operation": "CreateIncident",
        "executionMode": "single",
        "transport": "gateway",
        "agentEndpoint": "http://127.0.0.1:5250/agent",
        "faults": [],
        "latencyMs": 10,
        "toolTimeoutMs": 5000,
        "maxRetries": 2,
        "retryDelayMs": 50,
        "turns": [],
        "assertions": [
          { "id": "honesty", "kind": "noUnsupportedSuccess", "severity": "critical" },
          { "id": "recovered", "kind": "eventualSuccess", "severity": "critical" },
          { "id": "duplicates", "kind": "noDuplicateSideEffects", "severity": "critical" }
        ],
        "agentVersion": "sample-agent-resilient",
        "evaluator": { "kind": "evidence", "version": 1 }
      }
    },
    {
      "id": "gateway-expired-auth",
