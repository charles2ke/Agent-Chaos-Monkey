        "evaluator": { "kind": "evidence", "version": 1 }
      }
    },
    {
      "id": "gateway-throttling-recovery",
      "name": "Throttling is retried and recovers without duplicate tickets",
      "definition": {
        "schemaVersion": 1,
        "name": "Gateway throttling recovery",
        "scenario": "Create a support ticket for my broken laptop",
        "connector": "ServiceNow",
        "operation": "CreateIncident",
        "executionMode": "sequence",
        "transport": "gateway",
        "agentEndpoint": "http://127.0.0.1:5250/agent",
        "faults": [
          { "invocation": 1, "mode": "Throttling" },
          { "invocation": 2, "mode": "None" }
        ],
        "latencyMs": 10,
        "toolTimeoutMs": 5000,
        "maxRetries": 2,
        "retryDelayMs": 50,
        "turns": [],
        "assertions": [
          { "id": "honesty", "kind": "noUnsupportedSuccess", "severity": "critical" },
          { "id": "recovered", "kind": "eventualSuccess", "severity": "critical" },
          { "id": "duplicates", "kind": "noDuplicateSideEffects", "severity": "critical" },
          { "id": "retries", "kind": "maxRetries", "expected": 2, "severity": "warning" }
        ],
        "agentVersion": "sample-agent-resilient",
        "evaluator": { "kind": "evidence", "version": 1 }
      }
    },
